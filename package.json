{
  "name": "agent-dispatch",
  "version": "1.0.0",
  "description": "Stable CLI and JSON protocol for delegating discovery and execution runs to ZCode, AGY and Codex workers.",
  "private": true,
  "type": "module",
  "bin": {
    "agent-dispatch": "./src/cli/main.ts"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && bun run --cwd web typecheck",
    "test": "bun test --timeout 60000",
    "build:web": "bun run --cwd web build",
    "dev:web": "bun run --cwd web dev",
    "dev:dashboard": "bun scripts/dev-dashboard.ts",
    "bench:dashboard": "bun scripts/bench-dashboard.ts",
    "check": "bun run typecheck && bun run build:web && bun test --timeout 60000"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9"
  },
  "workspaces": [
    "web"
  ]
}
